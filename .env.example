# RAVEN Environment Variables
# Copy this file to .env and fill in your actual API keys.
# Never commit real API keys to version control.

# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key-here

# Google Gemini
GEMINI_API_KEY=your-gemini-api-key-here

# Anthropic
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# OpenAI-compatible APIs (Together, Bedrock, etc.)
OPENAI_COMPATIBLE_API_KEY=your-openai-compatible-key-here
OPENAI_COMPATIBLE_BASE_URL=https://api.together.xyz/v1

# Note: Local/offline models do not require API keys.
# Ensure the relevant CLI tools are installed (Ollama, Claude Code, Codex CLI).